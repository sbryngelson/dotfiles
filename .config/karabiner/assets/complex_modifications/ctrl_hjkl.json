{
  "title": "Vim navigation with Control",
  "rules": [
    {
      "description": "Ctrl+H/J/K/L → Left/Down/Up/Right arrows",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "l",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "right_arrow" }]
        }
      ]
    }
  ]
}
